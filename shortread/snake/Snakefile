rule build_star_index:
    input:
        init=INIT_SENTINEL,
        fasta=repo_path(config["references"]["genome_fasta"]),
        gtf=repo_path(config["references"]["genome_gtf"])
    output:
        directory(STAR_INDEX_DIR)
    log:
        log_path("reference", "star_genome_generate.log")
    benchmark:
        benchmark_path("reference", "star_genome_generate.tsv")
    threads: config["resources"]["star_index_threads"]
    conda:
        str(ENV_YAML)
    params:
        sjdb_overhang=config["star"]["sjdb_overhang"],
        extra=STAR_GENOME_GENERATE_EXTRA,
        benchmark_dir=str(Path(benchmark_path("reference", "star_genome_generate.tsv")).parent),
        cluster=slurm_cluster_args(
            "m_medium",
            "128G",
            "star_idx",
            log_path("slurm", "star_index.%A.log"),
            config["resources"]["star_index_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p {output} "$(dirname {log})" "{params.benchmark_dir}"
        STAR \
          --runMode genomeGenerate \
          --runThreadN {threads} \
          --genomeDir {output} \
          --genomeFastaFiles {input.fasta} \
          --sjdbGTFfile {input.gtf} \
          --sjdbOverhang {params.sjdb_overhang} \
          {params.extra} \
          > {log} 2>&1
        """


rule trim_reads:
    input:
        init=INIT_SENTINEL,
        r1=sample_fastq,
        r2=sample_fastq_r2
    output:
        r1=temp(results_path("trimmed", "r1", "{sample}.trimmed.fastq.gz")),
        r2=temp(results_path("trimmed", "r2", "{sample}.trimmed.fastq.gz"))
    log:
        log_path("trim", "{sample}.log")
    benchmark:
        benchmark_path("trim", "{sample}.tsv")
    threads: config["resources"]["trim_threads"]
    conda:
        str(ENV_YAML)
    params:
        min_length_r1=config["trim"]["min_length_r1"],
        min_length_r2=config["trim"]["min_length_r2"],
        times=config["trim"]["times"],
        adapter_args=lambda wildcards: TRIM_ADAPTER_ARGS,
        r2_fixed_5p_sequence=config["trim"]["r2_fixed_5p_sequence"],
        r2_adapter=lambda wildcards: TRIM_R2_ADAPTER,
        extra=config["trim"].get("extra", ""),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("trim", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "16G",
            "trim",
            log_path("slurm", f"trim.{wildcards.sample}.%A.log"),
            config["resources"]["trim_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.r1})" "$(dirname {output.r2})" "$(dirname {log})" "{params.benchmark_dir}"
        cutadapt \
          -j {threads} \
          --minimum-length {params.min_length_r1}:{params.min_length_r2} \
          --pair-filter=any \
          --times {params.times} \
          {params.adapter_args} \
          -G ^{params.r2_fixed_5p_sequence} \
          -A {params.r2_adapter} \
          --poly-a \
          {params.extra} \
          -o {output.r1} \
          -p {output.r2} \
          {input.r1} \
          {input.r2} \
          > {log} 2>&1
        """


rule fastqc_trimmed_reads:
    input:
        init=INIT_SENTINEL,
        r1=results_path("trimmed", "r1", "{sample}.trimmed.fastq.gz"),
        r2=results_path("trimmed", "r2", "{sample}.trimmed.fastq.gz")
    output:
        r1_html=results_path("qc", "fastqc", "trimmed", "r1", "{sample}.trimmed_fastqc.html"),
        r1_zip=results_path("qc", "fastqc", "trimmed", "r1", "{sample}.trimmed_fastqc.zip"),
        r2_html=results_path("qc", "fastqc", "trimmed", "r2", "{sample}.trimmed_fastqc.html"),
        r2_zip=results_path("qc", "fastqc", "trimmed", "r2", "{sample}.trimmed_fastqc.zip")
    log:
        log_path("qc_fastqc", "trimmed.{sample}.log")
    benchmark:
        benchmark_path("qc_fastqc", "trimmed.{sample}.tsv")
    threads: config["resources"]["fastqc_threads"]
    conda:
        str(ENV_YAML)
    params:
        outdir_r1=results_path("qc", "fastqc", "trimmed", "r1"),
        outdir_r2=results_path("qc", "fastqc", "trimmed", "r2"),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("qc_fastqc", f"trimmed.{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "8G",
            "fastqc_trim",
            log_path("slurm", f"fastqc_trim.{wildcards.sample}.%A.log"),
            config["resources"]["fastqc_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir_r1}" "{params.outdir_r2}" "$(dirname {log})" "{params.benchmark_dir}"
        fastqc --threads {threads} --outdir "{params.outdir_r1}" {input.r1} > {log} 2>&1
        fastqc --threads {threads} --outdir "{params.outdir_r2}" {input.r2} >> {log} 2>&1
        """


rule extract_umis:
    input:
        init=INIT_SENTINEL,
        r1=results_path("trimmed", "r1", "{sample}.trimmed.fastq.gz"),
        r2=results_path("trimmed", "r2", "{sample}.trimmed.fastq.gz")
    output:
        r1=temp(results_path("umi", "r1", "{sample}.umi_extracted.fastq.gz")),
        r2=temp(results_path("umi", "r2", "{sample}.umi_extracted.fastq.gz"))
    log:
        log_path("umi", "{sample}.log")
    benchmark:
        benchmark_path("umi", "{sample}.tsv")
    conda:
        str(ENV_YAML)
    params:
        extract_method=config["umi"]["extract_method"],
        bc_pattern=lambda wildcards: config["umi"]["bc_pattern"],
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("umi", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "24G",
            "umi_extract",
            log_path("slurm", f"umi_extract.{wildcards.sample}.%A.log"),
            1,
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.r1})" "$(dirname {output.r2})" "$(dirname {log})" "{params.benchmark_dir}"
        umi_tools extract \
          --extract-method={params.extract_method} \
          --bc-pattern={params.bc_pattern:q} \
          --stdin={input.r1} \
          --stdout={output.r1} \
          --read2-in={input.r2} \
          --read2-out={output.r2} \
          --log={log}
        """


