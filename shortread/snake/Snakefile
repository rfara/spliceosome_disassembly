rule initialize_workdirs:
    output:
        touch(INIT_SENTINEL)
    shell:
        r"""
        set -euo pipefail
        mkdir -p {WORKFLOW_DIRS:q}
        touch {output}
        """


rule build_rrna_index:
    input:
        init=INIT_SENTINEL,
        fasta=repo_path(config["references"]["rrna_fasta"])
    output:
        bowtie2_index_outputs(RRNA_INDEX_PREFIX)
    log:
        log_path("reference", "rrna_bowtie2_build.log")
    benchmark:
        benchmark_path("reference", "rrna_bowtie2_build.tsv")
    threads: config["resources"]["bowtie2_build_threads"]
    conda:
        str(ENV_YAML)
    params:
        prefix=RRNA_INDEX_PREFIX,
        benchmark_dir=str(Path(benchmark_path("reference", "rrna_bowtie2_build.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "16G",
            "rrna_idx",
            log_path("slurm", "rrna_index.%A.log"),
            config["resources"]["bowtie2_build_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {params.prefix})" "$(dirname {log})" "{params.benchmark_dir}"
        bowtie2-build \
          --threads {threads} \
          {input.fasta} \
          {params.prefix} \
          > {log} 2>&1
        """


