rule build_star_index:
    input:
        init=INIT_SENTINEL,
        fasta=repo_path(config["references"]["genome_fasta"]),
        gtf=repo_path(config["references"]["genome_gtf"])
    output:
        directory(STAR_INDEX_DIR)
    log:
        log_path("reference", "star_genome_generate.log")
    benchmark:
        benchmark_path("reference", "star_genome_generate.tsv")
    threads: config["resources"]["star_index_threads"]
    conda:
        str(ENV_YAML)
    params:
        sjdb_overhang=config["star"]["sjdb_overhang"],
        extra=STAR_GENOME_GENERATE_EXTRA,
        benchmark_dir=str(Path(benchmark_path("reference", "star_genome_generate.tsv")).parent),
        cluster=slurm_cluster_args(
            "m_medium",
            "256G",
            "star_idx",
            log_path("slurm", "star_index.%A.log"),
            config["resources"]["star_index_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p {output} "$(dirname {log})" "{params.benchmark_dir}"
        STAR \
          --runMode genomeGenerate \
          --runThreadN {threads} \
          --genomeDir {output} \
          --genomeFastaFiles {input.fasta} \
          --sjdbGTFfile {input.gtf} \
          --sjdbOverhang {params.sjdb_overhang} \
          {params.extra} \
          > {log} 2>&1
        """


rule trim_reads:
    input:
        init=INIT_SENTINEL,
        fastq=sample_fastq
    output:
        temp(results_path("trimmed", "{sample}.trimmed.fastq.gz"))
    log:
        log_path("trim", "{sample}.log")
    benchmark:
        benchmark_path("trim", "{sample}.tsv")
    threads: config["resources"]["trim_threads"]
    conda:
        str(ENV_YAML)
    params:
        min_length=config["trim"]["min_length"],
        times=config["trim"]["times"],
        adapter_args=lambda wildcards: TRIM_ADAPTER_ARGS,
        extra=config["trim"].get("extra", ""),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("trim", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "16G",
            "trim",
            log_path("slurm", f"trim.{wildcards.sample}.%A.log"),
            config["resources"]["trim_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output})" "$(dirname {log})" "{params.benchmark_dir}"
        cutadapt \
          -j {threads} \
          --minimum-length {params.min_length} \
          --times {params.times} \
          {params.adapter_args} \
          {params.extra} \
          -o {output} \
          {input.fastq} \
          > {log} 2>&1
        """


rule extract_umis:
    input:
        init=INIT_SENTINEL,
        fastq=results_path("trimmed", "{sample}.trimmed.fastq.gz")
    output:
        extracted=results_path("umi", "{sample}.umi_extracted.fastq.gz")
    log:
        log_path("umi", "{sample}.log")
    benchmark:
        benchmark_path("umi", "{sample}.tsv")
    conda:
        str(ENV_YAML)
    params:
        extract_method=config["umi"]["extract_method"],
        bc_pattern=lambda wildcards: config["umi"]["bc_pattern"],
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("umi", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "24G",
            "umi_extract",
            log_path("slurm", f"umi_extract.{wildcards.sample}.%A.log"),
            1,
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.extracted})" "$(dirname {log})" "{params.benchmark_dir}"
        umi_tools extract \
          --extract-method={params.extract_method} \
          --bc-pattern={params.bc_pattern:q} \
          --stdin={input.fastq} \
          --stdout={output.extracted} \
          --log={log}
        """


rule trim_fixed_5p_sequence:
    input:
        init=INIT_SENTINEL,
        fastq=results_path("umi", "{sample}.umi_extracted.fastq.gz")
    output:
        temp(results_path("umi", "ready", "{sample}.umi_ready.fastq.gz"))
    log:
        log_path("umi", "{sample}.fixed_5p_trim.log")
    benchmark:
        benchmark_path("umi", "{sample}.fixed_5p_trim.tsv")
    threads: 1
    conda:
        str(ENV_YAML)
    params:
        fixed_5p_sequence=config["umi"]["fixed_5p_sequence"],
        error_rate=config["umi"]["fixed_5p_error_rate"],
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("umi", f"{wildcards.sample}.fixed_5p_trim.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "16G",
            "umi_trim5p",
            log_path("slurm", f"umi_trim5p.{wildcards.sample}.%A.log"),
            1,
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output})" "$(dirname {log})" "{params.benchmark_dir}"
        cutadapt \
          -j {threads} \
          -g ^{params.fixed_5p_sequence} \
          --error-rate {params.error_rate} \
          --discard-untrimmed \
          -o {output} \
          {input.fastq} \
          > {log} 2>&1
        """


rule premap_rrna:
    input:
        init=INIT_SENTINEL,
        fastq=results_path("umi", "ready", "{sample}.umi_ready.fastq.gz"),
        index=bowtie2_index_outputs(RRNA_INDEX_PREFIX)
    output:
        bam=results_path("premap_rrna", "{sample}.rrna.bam"),
        unmapped=temp(results_path("premap_rrna", "{sample}.rrna_unmapped.fastq.gz"))
    log:
        log_path("premap_rrna", "{sample}.log")
    benchmark:
        benchmark_path("premap_rrna", "{sample}.tsv")
    threads: config["resources"]["premap_threads"]
    conda:
        str(ENV_YAML)
    params:
        index_prefix=RRNA_INDEX_PREFIX,
        args=PREMAP_ARGS,
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("premap_rrna", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "32G",
            "rrna_map",
            log_path("slurm", f"rrna_map.{wildcards.sample}.%A.log"),
            config["resources"]["premap_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "{params.benchmark_dir}"
        bowtie2 \
          --threads {threads} \
          -x {params.index_prefix} \
          -U {input.fastq} \
          --un-gz {output.unmapped} \
          --no-unal \
          -k 1 \
          {params.args} \
          2> {log} \
        | samtools view -@ {threads} -b - \
        | samtools sort -@ {threads} -o {output.bam} -
        """


