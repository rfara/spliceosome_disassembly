rule aggregate_branchpoint_profiles:
    input:
        init=INIT_SENTINEL,
        metaprofiles=expand(BRANCHPOINT_SAMPLE_METAPROFILE, sample=SAMPLES),
        summaries=expand(BRANCHPOINT_SAMPLE_SUMMARY, sample=SAMPLES),
        site_counts=expand(BRANCHPOINT_SAMPLE_SITE_COUNTS, sample=SAMPLES),
        intron_offsets=expand(BRANCHPOINT_SAMPLE_INTRON_OFFSETS, sample=SAMPLES)
    output:
        metaprofile_by_sample=BRANCHPOINT_COMBINED_METAPROFILE_BY_SAMPLE,
        metaprofile_by_condition=BRANCHPOINT_COMBINED_METAPROFILE_BY_CONDITION,
        summary_by_sample=BRANCHPOINT_COMBINED_SUMMARY_BY_SAMPLE,
        summary_by_condition=BRANCHPOINT_COMBINED_SUMMARY_BY_CONDITION,
        shared_introns=BRANCHPOINT_COMBINED_SHARED_INTRONS,
        plot_png=BRANCHPOINT_COMBINED_PLOT_PNG,
        plot_pdf=BRANCHPOINT_COMBINED_PLOT_PDF
    log:
        log_path("branchpoints_aggregate", "combined.log")
    benchmark:
        benchmark_path("branchpoints_aggregate", "combined.tsv")
    threads: config["resources"]["branchpoint_aggregate_threads"]
    conda:
        str(ENV_YAML)
    params:
        script=str((SCRIPTS_DIR / "aggregate_branchpoint_profiles.py").resolve()),
        metaprofile_args=lambda wildcards, input: " ".join(
            f"--metaprofile {shlex.quote(path)}" for path in input.metaprofiles
        ),
        summary_args=lambda wildcards, input: " ".join(
            f"--summary {shlex.quote(path)}" for path in input.summaries
        ),
        site_count_args=lambda wildcards, input: " ".join(
            f"--site-counts {shlex.quote(path)}" for path in input.site_counts
        ),
        intron_offset_args=lambda wildcards, input: " ".join(
            f"--intron-offsets {shlex.quote(path)}" for path in input.intron_offsets
        ),
        shared_min_reads=BRANCHPOINT_CFG["shared_min_reads_all_samples"],
        benchmark_dir=str(Path(benchmark_path("branchpoints_aggregate", "combined.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "8G",
            "bp_agg",
            log_path("slurm", "bp_agg.%A.log"),
            config["resources"]["branchpoint_aggregate_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.metaprofile_by_sample})" "$(dirname {log})" "{params.benchmark_dir}"
        python {params.script} \
          {params.metaprofile_args} \
          {params.summary_args} \
          {params.site_count_args} \
          {params.intron_offset_args} \
          --shared-min-reads {params.shared_min_reads} \
          --output-metaprofile-by-sample {output.metaprofile_by_sample} \
          --output-metaprofile-by-condition {output.metaprofile_by_condition} \
          --output-summary-by-sample {output.summary_by_sample} \
          --output-summary-by-condition {output.summary_by_condition} \
          --output-shared-introns {output.shared_introns} \
          --output-plot-png {output.plot_png} \
          --output-plot-pdf {output.plot_pdf} \
          > {log} 2>&1
        """


rule bam_qc:
    input:
        init=INIT_SENTINEL,
        bam=lambda wildcards: BAM_QC_STAGES[wildcards.stage].format(sample=wildcards.sample)
    output:
        flagstat=results_path("qc", "bam", "{stage}", "{sample}.flagstat.txt"),
        stats=results_path("qc", "bam", "{stage}", "{sample}.stats.txt")
    log:
        log_path("qc_bam", "{stage}.{sample}.log")
    benchmark:
        benchmark_path("qc_bam", "{stage}.{sample}.tsv")
    threads: config["resources"]["bam_qc_threads"]
    wildcard_constraints:
        stage="premap_rrna|premap_snrna|star|dedup"
    conda:
        str(ENV_YAML)
    params:
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("qc_bam", f"{wildcards.stage}.{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "8G",
            f"bam_qc_{wildcards.stage}",
            log_path("slurm", f"bam_qc.{wildcards.stage}.{wildcards.sample}.%A.log"),
            config["resources"]["bam_qc_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.flagstat})" "$(dirname {log})" "{params.benchmark_dir}"
        samtools flagstat -@ {threads} {input.bam} > {output.flagstat}
        samtools stats -@ {threads} {input.bam} > {output.stats}
        """


rule count_snrna_premap_reads:
    input:
        init=INIT_SENTINEL,
        bam=results_path("premap_snrna", "{sample}.snrna.bam")
    output:
        counts=results_path("qc", "snrna_counts", "{sample}.snrna_counts.tsv")
    log:
        log_path("qc_snrna_counts", "{sample}.log")
    benchmark:
        benchmark_path("qc_snrna_counts", "{sample}.tsv")
    threads: config["resources"]["snrna_count_threads"]
    conda:
        str(ENV_YAML)
    params:
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("qc_snrna_counts", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "8G",
            "snrna_count",
            log_path("slurm", f"snrna_count.{wildcards.sample}.%A.log"),
            config["resources"]["snrna_count_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.counts})" "$(dirname {log})" "{params.benchmark_dir}"
        idxstats_file="$(mktemp)"
        fragments_file="$(mktemp)"
        trap 'rm -f "$idxstats_file" "$fragments_file"' EXIT
        samtools idxstats {input.bam} > "$idxstats_file"
        samtools view -@ {threads} -F 2308 {input.bam} \
          | cut -f 1,3 \
          | sort -u \
          | cut -f 2 \
          | sort \
          | uniq -c > "$fragments_file"
        python - "$idxstats_file" "$fragments_file" "{output.counts}" > {log} 2>&1 <<'PY'
import sys

idxstats_path, fragments_path, output_path = sys.argv[1:4]

counts = {{}}
order = []
with open(idxstats_path) as handle:
    for line in handle:
        ref, length, mapped, unmapped = line.rstrip().split("\t")
        if ref == "*":
            continue
        counts[ref] = {{
            "length": int(length),
            "read_count": int(mapped),
            "fragment_count": 0,
        }}
        order.append(ref)

with open(fragments_path) as handle:
    for line in handle:
        line = line.strip()
        if not line:
            continue
        count, ref = line.split(None, 1)
        if ref in counts:
            counts[ref]["fragment_count"] = int(count)

with open(output_path, "w") as handle:
    handle.write("reference\tlength\tread_count\tfragment_count\n")
    for ref in order:
        entry = counts[ref]
        handle.write(
            f"{{ref}}\t{{entry['length']}}\t{{entry['read_count']}}\t{{entry['fragment_count']}}\n"
        )
PY
        """


rule qualimap_rnaseq_qc:
    input:
        init=INIT_SENTINEL,
        bam=lambda wildcards: QUALIMAP_RNASEQ_STAGES[wildcards.stage].format(sample=wildcards.sample),
        bai=qualimap_bam_index,
        gtf=repo_path(config["references"]["genome_gtf"])
    output:
        html=results_path("qc", "qualimap", "{stage}", "{sample}", "qualimapReport.html"),
        summary=results_path("qc", "qualimap", "{stage}", "{sample}", "rnaseq_qc_results.txt")
    log:
        log_path("qc_qualimap", "{stage}.{sample}.log")
    benchmark:
        benchmark_path("qc_qualimap", "{stage}.{sample}.tsv")
    threads: 1
    wildcard_constraints:
        stage="star|dedup"
    conda:
        str(ENV_YAML)
    params:
        outdir=lambda wildcards: results_path("qc", "qualimap", wildcards.stage, wildcards.sample),
        java_mem=config["qualimap"]["java_mem"],
        protocol=config["qualimap"]["protocol"],
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("qc_qualimap", f"{wildcards.stage}.{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "m_medium",
            config["qualimap"]["slurm_mem"],
            f"qualimap_{wildcards.stage}",
            log_path("slurm", f"qualimap.{wildcards.stage}.{wildcards.sample}.%A.log"),
            1,
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}" "$(dirname {log})" "{params.benchmark_dir}"
        unset DISPLAY
        export JAVA_OPTS="-Djava.awt.headless=true"
        qualimap rnaseq \
          --java-mem-size={params.java_mem} \
          -bam {input.bam} \
          -gtf {input.gtf} \
          -outdir {params.outdir} \
          -outformat HTML \
          -p {params.protocol} \
          -pe \
          > {log} 2>&1
        """
