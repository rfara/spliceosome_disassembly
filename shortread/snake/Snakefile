rule map_genome_star:
    input:
        init=INIT_SENTINEL,
        fastq=results_path("premap_snrna", "{sample}.snrna_unmapped.fastq.gz"),
        index=STAR_INDEX_DIR
    output:
        bam=results_path("star", "{sample}.Aligned.sortedByCoord.out.bam"),
        summary=results_path("star", "{sample}.Log.final.out"),
        junctions=results_path("star", "{sample}.SJ.out.tab")
    log:
        log_path("star", "{sample}.log")
    benchmark:
        benchmark_path("star", "{sample}.tsv")
    threads: config["resources"]["star_map_threads"]
    conda:
        str(ENV_YAML)
    params:
        prefix=lambda wildcards: results_path("star", f"{wildcards.sample}."),
        sort_ram=config["star"]["limit_bam_sort_ram"],
        align_extra=STAR_ALIGN_EXTRA,
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("star", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "32G",
            "star_map",
            log_path("slurm", f"star_map.{wildcards.sample}.%A.log"),
            config["resources"]["star_map_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "{params.benchmark_dir}"
        STAR \
          --runThreadN {threads} \
          --genomeDir {input.index} \
          --readFilesIn {input.fastq} \
          --readFilesCommand zcat \
          --alignEndsType EndToEnd \
          --outSAMtype BAM SortedByCoordinate \
          --outSAMattributes NH HI AS nM MD \
          --limitBAMsortRAM {params.sort_ram} \
          --outFileNamePrefix {params.prefix} \
          {params.align_extra} \
          > {log} 2>&1
        mv {params.prefix}Aligned.sortedByCoord.out.bam {output.bam}
        mv {params.prefix}Log.final.out {output.summary}
        mv {params.prefix}SJ.out.tab {output.junctions}
        rm -f {params.prefix}Log.out {params.prefix}Log.progress.out
        """


rule deduplicate_bam:
    input:
        init=INIT_SENTINEL,
        bam=results_path("star", "{sample}.Aligned.sortedByCoord.out.bam")
    output:
        bam=results_path("dedup", "{sample}.dedup.bam")
    log:
        log_path("dedup", "{sample}.log")
    benchmark:
        benchmark_path("dedup", "{sample}.tsv")
    threads: config["resources"]["dedup_sort_threads"]
    conda:
        str(ENV_YAML)
    params:
        temp_dir=results_path("tmp", "umi_dedup", "{sample}"),
        sort_memory=config["dedup"]["samtools_sort_memory"],
        method=config["dedup"]["method"],
        multimap_tag=config["dedup"]["multimapping_detection_method"],
        extra=config["dedup"].get("extra", ""),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("dedup", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "m_medium",
            "128G",
            "umi_dedup",
            log_path("slurm", f"umi_dedup.{wildcards.sample}.%A.log"),
            config["resources"]["dedup_sort_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "{params.temp_dir}" "$(dirname {log})" "{params.benchmark_dir}"
        umi_tools dedup \
          --stdin={input.bam} \
          --log={log} \
          --temp-dir={params.temp_dir} \
          --method={params.method} \
          --multimapping-detection-method={params.multimap_tag} \
          --spliced-is-unique \
          --unmapped-reads=discard \
          --no-sort-output \
          {params.extra} \
        | samtools sort \
            -@ {threads} \
            -m {params.sort_memory} \
            -o {output.bam} \
            -
        """


rule index_deduplicated_bam:
    input:
        init=INIT_SENTINEL,
        bam=results_path("dedup", "{sample}.dedup.bam")
    output:
        bai=results_path("dedup", "{sample}.dedup.bam.bai")
    log:
        log_path("dedup_index", "{sample}.log")
    benchmark:
        benchmark_path("dedup_index", "{sample}.tsv")
    threads: config["resources"]["samtools_index_threads"]
    conda:
        str(ENV_YAML)
    params:
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("dedup_index", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "8G",
            "bam_index",
            log_path("slurm", f"bam_index.{wildcards.sample}.%A.log"),
            config["resources"]["samtools_index_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bai})" "$(dirname {log})" "{params.benchmark_dir}"
        samtools index -@ {threads} {input.bam} {output.bai} > {log} 2>&1
        """
