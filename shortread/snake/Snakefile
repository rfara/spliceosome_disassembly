from pathlib import Path
import shlex


WORKFLOW_DIR = Path(workflow.basedir).resolve()
REPO_ROOT = WORKFLOW_DIR.parents[1]
RESULTS_DIR = WORKFLOW_DIR / "results"
LOG_DIR = WORKFLOW_DIR / "logs"
BENCHMARK_DIR = WORKFLOW_DIR / "benchmarks"
ENV_YAML = WORKFLOW_DIR / "envs" / "rnaseq_pipeline.yml"
SCRIPTS_DIR = WORKFLOW_DIR / "scripts"

configfile: str(WORKFLOW_DIR / "config.yaml")

shell.executable("bash")


def repo_path(path_string):
    path = Path(path_string)
    if path.is_absolute():
        return str(path)
    return str((REPO_ROOT / path).resolve())


def results_path(*parts):
    return str((RESULTS_DIR.joinpath(*parts)).resolve())


def log_path(*parts):
    return str((LOG_DIR.joinpath(*parts)).resolve())


def benchmark_path(*parts):
    return str((BENCHMARK_DIR.joinpath(*parts)).resolve())


SAMPLES = list(config["samples"].keys())
BRANCHPOINT_CFG = config["branchpoint_analysis"]

BT2_SUFFIXES = [
    ".1.bt2",
    ".2.bt2",
    ".3.bt2",
    ".4.bt2",
    ".rev.1.bt2",
    ".rev.2.bt2",
]

RRNA_INDEX_PREFIX = results_path("reference", "rrna", "rrna")
SNRNA_INDEX_PREFIX = results_path("reference", "snrna", "snrna")
STAR_INDEX_DIR = results_path("reference", "star_genome")
SLURM_TIME_LIMITS = config["slurm"]["time_limits"]
BRANCHPOINT_GTF = repo_path(BRANCHPOINT_CFG["mane_gtf"])
BRANCHPOINT_SCORE_FILE = repo_path(BRANCHPOINT_CFG["branchpoints"])
BRANCHPOINT_REFERENCE = results_path("branchpoints", "reference", "mane_select_top_branchpoints.tsv")
BRANCHPOINT_SAMPLE_METAPROFILE = results_path("branchpoints", "samples", "{sample}.metaprofile.tsv")
BRANCHPOINT_SAMPLE_SUMMARY = results_path("branchpoints", "samples", "{sample}.summary.tsv")
BRANCHPOINT_SAMPLE_SITE_COUNTS = results_path("branchpoints", "samples", "{sample}.site_counts.tsv.gz")
BRANCHPOINT_SAMPLE_INTRON_OFFSETS = results_path("branchpoints", "samples", "{sample}.offset_counts.tsv.gz")
BRANCHPOINT_COMBINED_METAPROFILE_BY_SAMPLE = results_path("branchpoints", "combined", "metaprofile.by_sample.tsv")
BRANCHPOINT_COMBINED_METAPROFILE_BY_CONDITION = results_path("branchpoints", "combined", "metaprofile.by_condition.tsv")
BRANCHPOINT_COMBINED_SUMMARY_BY_SAMPLE = results_path("branchpoints", "combined", "summary.by_sample.tsv")
BRANCHPOINT_COMBINED_SUMMARY_BY_CONDITION = results_path("branchpoints", "combined", "summary.by_condition.tsv")
BRANCHPOINT_COMBINED_SHARED_INTRONS = results_path("branchpoints", "combined", "shared_introns.tsv")
