    output:
        site_counts=BRANCHPOINT_SAMPLE_SITE_COUNTS,
        offset_counts=BRANCHPOINT_SAMPLE_INTRON_OFFSETS,
        three_prime_coverage=BRANCHPOINT_SAMPLE_THREE_PRIME_COVERAGE,
