    conda:
        str(ENV_YAML)
    params:
        temp_dir=results_path("tmp", "umi_dedup", "{sample}"),
        sort_memory=config["dedup"]["samtools_sort_memory"],
        method=config["dedup"]["method"],
        multimap_tag=config["dedup"]["multimapping_detection_method"],
        extra=config["dedup"].get("extra", ""),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("dedup", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "m_medium",
