rule premap_rrna:
    input:
        init=INIT_SENTINEL,
        r1=results_path("umi", "ready", "r1", "{sample}.umi_ready.fastq.gz"),
        r2=results_path("umi", "ready", "r2", "{sample}.umi_ready.fastq.gz"),
        index=bowtie2_index_outputs(RRNA_INDEX_PREFIX)
    output:
        bam=results_path("premap_rrna", "{sample}.rrna.bam"),
        unmapped_r1=temp(results_path("premap_rrna", "{sample}.rrna_unmapped.1.fastq.gz")),
        unmapped_r2=temp(results_path("premap_rrna", "{sample}.rrna_unmapped.2.fastq.gz"))
    log:
        log_path("premap_rrna", "{sample}.log")
    benchmark:
        benchmark_path("premap_rrna", "{sample}.tsv")
    threads: config["resources"]["premap_threads"]
    conda:
        str(ENV_YAML)
    params:
        index_prefix=RRNA_INDEX_PREFIX,
        args=PREMAP_ARGS,
        temp_bam=lambda wildcards: results_path("tmp", "premap", f"{wildcards.sample}.rrna_premap.raw.bam"),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("premap_rrna", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "32G",
            "rrna_map",
            log_path("slurm", f"rrna_map.{wildcards.sample}.%A.log"),
            config["resources"]["premap_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "$(dirname {params.temp_bam})" "{params.benchmark_dir}"
        bowtie2 \
          --threads {threads} \
          -x {params.index_prefix} \
          -1 {input.r1} \
          -2 {input.r2} \
          --no-discordant \
          -k 1 \
          {params.args} \
          2> {log} \
        | samtools view -@ {threads} -u - > {params.temp_bam}
        samtools view -@ {threads} -u -F 12 {params.temp_bam} \
        | samtools sort -@ {threads} -o {output.bam} -
        samtools view -@ {threads} -u -f 12 {params.temp_bam} \
        | samtools collate -@ {threads} -u -O - \
        | samtools fastq \
            -1 >(gzip -c > {output.unmapped_r1}) \
            -2 >(gzip -c > {output.unmapped_r2}) \
            -0 /dev/null \
            -s /dev/null \
            -n -
        rm -f {params.temp_bam}
        """


