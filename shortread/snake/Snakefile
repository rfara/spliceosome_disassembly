rule map_genome_star:
    input:
        init=INIT_SENTINEL,
        r1=results_path("premap_snrna", "{sample}.snrna_unmapped.1.fastq.gz"),
        r2=results_path("premap_snrna", "{sample}.snrna_unmapped.2.fastq.gz"),
        index=STAR_INDEX_DIR
    output:
        bam=results_path("star", "{sample}.Aligned.sortedByCoord.out.bam"),
        summary=results_path("star", "{sample}.Log.final.out"),
        junctions=results_path("star", "{sample}.SJ.out.tab"),
        unmapped_r1=results_path("star", "{sample}.Unmapped.out.mate1"),
        unmapped_r2=results_path("star", "{sample}.Unmapped.out.mate2")
    log:
        log_path("star", "{sample}.log")
    benchmark:
        benchmark_path("star", "{sample}.tsv")
    threads: config["resources"]["star_map_threads"]
    conda:
        str(ENV_YAML)
    params:
        prefix=lambda wildcards: results_path("star", f"{wildcards.sample}."),
        sort_ram=config["star"]["limit_bam_sort_ram"],
        align_extra=STAR_ALIGN_EXTRA,
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("star", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "m_medium",
            "96G",
            "star_map",
            log_path("slurm", f"star_map.{wildcards.sample}.%A.log"),
            config["resources"]["star_map_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "{params.benchmark_dir}"
        STAR \
          --runThreadN {threads} \
          --genomeDir {input.index} \
          --readFilesIn {input.r1} {input.r2} \
          --readFilesCommand zcat \
          --alignEndsType EndToEnd \
          --outReadsUnmapped Fastx \
          --outSAMtype BAM SortedByCoordinate \
          --outSAMattributes NH HI AS nM MD \
          --limitBAMsortRAM {params.sort_ram} \
          --outFileNamePrefix {params.prefix} \
          {params.align_extra} \
          > {log} 2>&1
        rm -f {params.prefix}Log.out {params.prefix}Log.progress.out
        """


