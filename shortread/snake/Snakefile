        profile_downstream=BRANCHPOINT_CFG["profile_downstream"],
        three_prime_coverage_upstream=BRANCHPOINT_CFG.get(
            "three_prime_coverage_upstream",
            BRANCHPOINT_CFG["profile_upstream"],
        ),
        three_prime_coverage_downstream=BRANCHPOINT_CFG.get(
            "three_prime_coverage_downstream",
            BRANCHPOINT_CFG["profile_downstream"],
