from pathlib import Path
import shlex


WORKFLOW_DIR = Path(workflow.basedir).resolve()
REPO_ROOT = WORKFLOW_DIR.parents[1]
RESULTS_DIR = WORKFLOW_DIR / "results"
LOG_DIR = WORKFLOW_DIR / "logs"
BENCHMARK_DIR = WORKFLOW_DIR / "benchmarks"
ENV_YAML = WORKFLOW_DIR / "envs" / "rnaseq_pipeline.yml"

configfile: str(WORKFLOW_DIR / "config.yaml")

shell.executable("bash")


def repo_path(path_string):
    path = Path(path_string)
    if path.is_absolute():
        return str(path)
    return str((REPO_ROOT / path).resolve())


def results_path(*parts):
    return str((RESULTS_DIR.joinpath(*parts)).resolve())


def log_path(*parts):
    return str((LOG_DIR.joinpath(*parts)).resolve())


def benchmark_path(*parts):
    return str((BENCHMARK_DIR.joinpath(*parts)).resolve())


SAMPLES = list(config["samples"].keys())

BT2_SUFFIXES = [
    ".1.bt2",
    ".2.bt2",
    ".3.bt2",
    ".4.bt2",
    ".rev.1.bt2",
    ".rev.2.bt2",
]

RRNA_INDEX_PREFIX = results_path("reference", "rrna", "rrna")
SNRNA_INDEX_PREFIX = results_path("reference", "snrna", "snrna")
STAR_INDEX_DIR = results_path("reference", "star_genome")
SLURM_TIME_LIMITS = config["slurm"]["time_limits"]


def bowtie2_index_outputs(prefix):
    return [prefix + suffix for suffix in BT2_SUFFIXES]


def sample_fastq(wildcards):
    return repo_path(config["samples"][wildcards.sample])


def cutadapt_adapter_args():
    trim_cfg = config["trim"]
    adapters = [
        f"G{{{trim_cfg['poly_g_min']}}}",
        f"A{{{trim_cfg['poly_a_min']}}}",
        *trim_cfg["illumina_3p_adapters"],
    ]
    return " ".join(f"-a {shlex.quote(adapter)}" for adapter in adapters)


def bowtie2_preset(cfg):
    parts = [cfg["preset"]]
    extra = cfg.get("extra", "").strip()
    if extra:
        parts.append(extra)
    return " ".join(parts)


def star_genome_generate_extra():
    star_cfg = config["star"]
    parts = []
    genome_sa_index_nbases = star_cfg.get("genome_sa_index_nbases")
    if genome_sa_index_nbases is not None:
        parts.extend(["--genomeSAindexNbases", str(genome_sa_index_nbases)])
    extra = star_cfg.get("genome_generate_extra", "").strip()
    if extra:
        parts.append(extra)
    return " ".join(parts)


def star_align_extra():
    extra = config["star"].get("align_extra", "").strip()
    return extra


def slurm_cluster_args(qos, mem, job_name, slurm_log_file, threads):
    partition, tier = qos.split("_", 1)
    time_limit = SLURM_TIME_LIMITS[tier]
    parts = [
        f"--partition={partition}",
        f"--qos={qos}",
        f"--time={time_limit}",
        f"--mem={mem}",
        f"--cpus-per-task={threads}",
        f"-J {job_name}",
        f"-o {slurm_log_file}",
    ]
    extra = config["slurm"].get("sbatch_extra", "").strip()
    if extra:
        parts.append(extra)
    return " ".join(parts)


TRIM_ADAPTER_ARGS = cutadapt_adapter_args()
PREMAP_ARGS = bowtie2_preset(config["premap"])
STAR_GENOME_GENERATE_EXTRA = star_genome_generate_extra()
STAR_ALIGN_EXTRA = star_align_extra()
INIT_SENTINEL = results_path(".workflow_dirs_initialized")
WORKFLOW_DIRS = [
    results_path("reference", "rrna"),
    results_path("reference", "snrna"),
    results_path("reference", "star_genome"),
    results_path("trimmed"),
    results_path("umi"),
    # results_path("umi", "filtered"),
    results_path("umi", "ready"),
    results_path("premap_rrna"),
    results_path("premap_snrna"),
    results_path("star"),
    results_path("dedup"),
    results_path("tmp", "umi_dedup"),
    log_path("reference"),
    log_path("trim"),
    log_path("umi"),
    log_path("premap_rrna"),
    log_path("premap_snrna"),
    log_path("star"),
    log_path("dedup"),
    log_path("dedup_index"),
    log_path("slurm"),
    benchmark_path("reference"),
    benchmark_path("trim"),
    benchmark_path("umi"),
    benchmark_path("premap_rrna"),
    benchmark_path("premap_snrna"),
    benchmark_path("star"),
    benchmark_path("dedup"),
    benchmark_path("dedup_index"),
]


localrules: initialize_workdirs


rule all:
    input:
        expand(results_path("dedup", "{sample}.dedup.bam"), sample=SAMPLES),
        expand(results_path("dedup", "{sample}.dedup.bam.bai"), sample=SAMPLES),


rule initialize_workdirs:
    output:
        touch(INIT_SENTINEL)
    shell:
        r"""
        set -euo pipefail
        mkdir -p {WORKFLOW_DIRS:q}
        touch {output}
        """


rule build_rrna_index:
    input:
        init=INIT_SENTINEL,
        fasta=repo_path(config["references"]["rrna_fasta"])
    output:
        bowtie2_index_outputs(RRNA_INDEX_PREFIX)
    log:
        log_path("reference", "rrna_bowtie2_build.log")
    benchmark:
        benchmark_path("reference", "rrna_bowtie2_build.tsv")
    threads: config["resources"]["bowtie2_build_threads"]
    conda:
        str(ENV_YAML)
    params:
        prefix=RRNA_INDEX_PREFIX,
        benchmark_dir=str(Path(benchmark_path("reference", "rrna_bowtie2_build.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "16G",
            "rrna_idx",
            log_path("slurm", "rrna_index.%A.log"),
            config["resources"]["bowtie2_build_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {params.prefix})" "$(dirname {log})" "{params.benchmark_dir}"
        bowtie2-build \
          --threads {threads} \
          {input.fasta} \
          {params.prefix} \
          > {log} 2>&1
        """


