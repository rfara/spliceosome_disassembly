localrules: initialize_workdirs


rule all:
    input:
        expand(results_path("dedup", "{sample}.dedup.bam"), sample=SAMPLES),
        expand(results_path("dedup", "{sample}.dedup.bam.bai"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "trimmed", "r1", "{sample}.trimmed_fastqc.html"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "trimmed", "r1", "{sample}.trimmed_fastqc.zip"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "trimmed", "r2", "{sample}.trimmed_fastqc.html"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "trimmed", "r2", "{sample}.trimmed_fastqc.zip"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "umi", "r1", "{sample}.umi_ready_fastqc.html"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "umi", "r1", "{sample}.umi_ready_fastqc.zip"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "umi", "r2", "{sample}.umi_ready_fastqc.html"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "umi", "r2", "{sample}.umi_ready_fastqc.zip"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "star_unmapped", "r1", "{sample}.star_unmapped_fastqc.html"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "star_unmapped", "r1", "{sample}.star_unmapped_fastqc.zip"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "star_unmapped", "r2", "{sample}.star_unmapped_fastqc.html"), sample=SAMPLES),
        expand(results_path("qc", "fastqc", "star_unmapped", "r2", "{sample}.star_unmapped_fastqc.zip"), sample=SAMPLES),
        expand(results_path("qc", "star_unmapped", "{sample}.summary.tsv"), sample=SAMPLES),
        expand(results_path("qc", "bam", "{stage}", "{sample}.flagstat.txt"), sample=SAMPLES, stage=BAM_QC_STAGES.keys()),
        expand(results_path("qc", "bam", "{stage}", "{sample}.stats.txt"), sample=SAMPLES, stage=BAM_QC_STAGES.keys()),
        expand(results_path("qc", "snrna_counts", "{sample}.snrna_counts.tsv"), sample=SAMPLES),
        expand(results_path("qc", "qualimap", "{stage}", "{sample}", "qualimapReport.html"), sample=SAMPLES, stage=QUALIMAP_RNASEQ_STAGES.keys()),
        expand(results_path("qc", "qualimap", "{stage}", "{sample}", "rnaseq_qc_results.txt"), sample=SAMPLES, stage=QUALIMAP_RNASEQ_STAGES.keys()),


rule initialize_workdirs:
    output:
        touch(INIT_SENTINEL)
    shell:
        r"""
        set -euo pipefail
        mkdir -p {WORKFLOW_DIRS:q}
        touch {output}
        """


rule build_rrna_index:
    input:
        init=INIT_SENTINEL,
        fasta=repo_path(config["references"]["rrna_fasta"])
    output:
        bowtie2_index_outputs(RRNA_INDEX_PREFIX)
    log:
        log_path("reference", "rrna_bowtie2_build.log")
    benchmark:
        benchmark_path("reference", "rrna_bowtie2_build.tsv")
    threads: config["resources"]["bowtie2_build_threads"]
    conda:
        str(ENV_YAML)
    params:
        prefix=RRNA_INDEX_PREFIX,
        benchmark_dir=str(Path(benchmark_path("reference", "rrna_bowtie2_build.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "16G",
            "rrna_idx",
            log_path("slurm", "rrna_index.%A.log"),
            config["resources"]["bowtie2_build_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {params.prefix})" "$(dirname {log})" "{params.benchmark_dir}"
        bowtie2-build \
          --threads {threads} \
          {input.fasta} \
          {params.prefix} \
          > {log} 2>&1
        """


