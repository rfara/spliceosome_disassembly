        expand(results_path("qc", "rna_content", "{sample}.rna_content.tsv"), sample=SAMPLES),
        expand(results_path("qc", "star_unmapped", "{sample}.summary.tsv"), sample=SAMPLES),
        expand(results_path("qc", "bam", "{stage}", "{sample}.flagstat.txt"), sample=SAMPLES, stage=BAM_QC_STAGES.keys()),
        expand(results_path("qc", "bam", "{stage}", "{sample}.stats.txt"), sample=SAMPLES, stage=BAM_QC_STAGES.keys()),
