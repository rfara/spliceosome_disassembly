def bowtie2_index_outputs(prefix):
    return [prefix + suffix for suffix in BT2_SUFFIXES]


def sample_fastq(wildcards):
    return repo_path(config["samples"][wildcards.sample])


def sample_fastq_r2(wildcards):
    r1 = config["samples"][wildcards.sample]
    if "_R1_" in r1:
        return repo_path(r1.replace("_R1_", "_R2_"))
    if "_R1." in r1:
        return repo_path(r1.replace("_R1.", "_R2."))
    raise ValueError(f"Could not derive R2 path from R1 path: {r1}")
def sample_condition(sample):
    sample_conditions = BRANCHPOINT_CFG.get("sample_conditions", {})
    if sample in sample_conditions:
        return sample_conditions[sample]
    return sample.split("_", 1)[0]


def format_cutadapt_adapter(adapter, min_overlap=None, error_rate=None, disallow_internal=False):
    spec = str(adapter).strip()
    if disallow_internal and not spec.endswith("X"):
        spec = f"{spec}X"

    adapter_params = []
    if error_rate is not None:
        adapter_params.append(f"e={error_rate}")
    if min_overlap is not None:
        adapter_params.append(f"min_overlap={min_overlap}")
    if adapter_params:
        spec = f"{spec};" + ";".join(adapter_params)
    return spec


def cutadapt_r1_adapter_args():
    trim_cfg = config["trim"]
    adapters = [
        format_cutadapt_adapter(
            f"A{{{trim_cfg['poly_a_min']}}}",
            min_overlap=trim_cfg["poly_a_min"],
        ),
        format_cutadapt_adapter(
            f"G{{{trim_cfg['poly_g_min']}}}",
            min_overlap=trim_cfg["poly_g_min"],
            disallow_internal=True,
        ),
        *[
            format_cutadapt_adapter(
                adapter,
                min_overlap=trim_cfg.get("adapter_min_overlap", 6),
            )
            for adapter in trim_cfg["illumina_3p_adapters"]
        ],
    ]
    return " ".join(f"-a {shlex.quote(adapter)}" for adapter in adapters)


def bowtie2_preset(cfg):
    parts = [cfg["preset"]]
    extra = cfg.get("extra", "").strip()
    if extra:
        parts.append(extra)
    return " ".join(parts)


def star_genome_generate_extra():
    star_cfg = config["star"]
    parts = []
    genome_sa_index_nbases = star_cfg.get("genome_sa_index_nbases")
    if genome_sa_index_nbases is not None:
        parts.extend(["--genomeSAindexNbases", str(genome_sa_index_nbases)])
    extra = star_cfg.get("genome_generate_extra", "").strip()
    if extra:
        parts.append(extra)
    return " ".join(parts)


def star_align_extra():
    extra = config["star"].get("align_extra", "").strip()
    return extra


def cutadapt_r2_adapter():
    trim_cfg = config["trim"]
    return format_cutadapt_adapter(
        trim_cfg["r2_3p_adapter"],
        min_overlap=trim_cfg.get("r2_adapter_min_overlap", 23),
        error_rate=trim_cfg.get("r2_adapter_error_rate", 0.2),
    )


def cutadapt_r2_poly_g_adapter():
    trim_cfg = config["trim"]
    return format_cutadapt_adapter(
        f"G{{{trim_cfg['poly_g_min']}}}",
        min_overlap=trim_cfg["poly_g_min"],
        disallow_internal=True,
    )


def slurm_cluster_args(qos, mem, job_name, slurm_log_file, threads):
    partition, tier = qos.split("_", 1)
    time_limit = SLURM_TIME_LIMITS[tier]
    parts = [
        f"--partition={partition}",
        f"--qos={qos}",
        f"--time={time_limit}",
        f"--mem={mem}",
        f"--cpus-per-task={threads}",
        f"-J {job_name}",
        f"-o {slurm_log_file}",
    ]
    extra = config["slurm"].get("sbatch_extra", "").strip()
    if extra:
        parts.append(extra)
    return " ".join(parts)


