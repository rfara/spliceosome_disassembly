rule trim_reads:
    input:
        init=INIT_SENTINEL,
        r1=sample_fastq,
        r2=sample_fastq_r2
    output:
        r1=temp(results_path("trimmed", "r1", "{sample}.trimmed.fastq.gz")),
        r2=temp(results_path("trimmed", "r2", "{sample}.trimmed.fastq.gz"))
    log:
        log_path("trim", "{sample}.log")
    benchmark:
        benchmark_path("trim", "{sample}.tsv")
    threads: config["resources"]["trim_threads"]
    conda:
        str(ENV_YAML)
    params:
        min_length_r1=config["trim"]["min_length_r1"],
        min_length_r2=config["trim"]["min_length_r2"],
        times=config["trim"]["times"],
        r1_adapter_args=lambda wildcards: TRIM_R1_ADAPTER_ARGS,
        r2_fixed_5p_sequence=config["trim"]["r2_fixed_5p_sequence"],
        r2_adapter=lambda wildcards: TRIM_R2_ADAPTER,
        r2_poly_g_adapter=lambda wildcards: TRIM_R2_POLY_G_ADAPTER,
        extra=config["trim"].get("extra", ""),
        tmp_root=results_path("tmp", "trim"),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("trim", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "16G",
            "trim",
            log_path("slurm", f"trim.{wildcards.sample}.%A.log"),
            config["resources"]["trim_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.r1})" "$(dirname {output.r2})" "$(dirname {log})" "{params.benchmark_dir}" "{params.tmp_root}"
        tmpdir="$(mktemp -d "{params.tmp_root}/{wildcards.sample}.XXXXXX")"
        trap 'rm -rf "$tmpdir"' EXIT
        cutadapt \
          -j {threads} \
          --times {params.times} \
          {params.r1_adapter_args} \
          -G ^{params.r2_fixed_5p_sequence} \
          -A {params.r2_adapter:q} \
          --poly-a \
          {params.extra} \
          -o "$tmpdir/{wildcards.sample}.step1.r1.fastq.gz" \
          -p "$tmpdir/{wildcards.sample}.step1.r2.fastq.gz" \
          {input.r1} \
          {input.r2} \
          > {log} 2>&1
        cutadapt \
          -j {threads} \
          --minimum-length {params.min_length_r1}:{params.min_length_r2} \
          --pair-filter=any \
          -A {params.r2_poly_g_adapter:q} \
          -o {output.r1} \
          -p {output.r2} \
          "$tmpdir/{wildcards.sample}.step1.r1.fastq.gz" \
          "$tmpdir/{wildcards.sample}.step1.r2.fastq.gz" \
          >> {log} 2>&1
        """


