rule aggregate_premrna_mrna:
    input:
        init=INIT_SENTINEL,
        gene_counts=expand(PREMRNA_SAMPLE_GENE_COUNTS, sample=SAMPLES),
        coverages=expand(PREMRNA_SAMPLE_COVERAGE, sample=SAMPLES),
        summaries=expand(PREMRNA_SAMPLE_SUMMARY, sample=SAMPLES)
    output:
        metaprofile_by_sample=PREMRNA_COMBINED_METAPROFILE_BY_SAMPLE,
        metaprofile_by_condition=PREMRNA_COMBINED_METAPROFILE_BY_CONDITION,
        summary_by_sample=PREMRNA_COMBINED_SUMMARY_BY_SAMPLE,
        summary_by_condition=PREMRNA_COMBINED_SUMMARY_BY_CONDITION,
        shared_genes=PREMRNA_COMBINED_SHARED_GENES
    log:
        log_path("premrna_aggregate", "combined.log")
    benchmark:
        benchmark_path("premrna_aggregate", "combined.tsv")
    threads: config["resources"]["premrna_aggregate_threads"]
    conda:
        str(ENV_YAML)
    params:
        script=str((SCRIPTS_DIR / "aggregate_premrna_mrna.py").resolve()),
        gene_count_args=lambda wildcards, input: " ".join(
            f"--gene-counts {shlex.quote(path)}" for path in input.gene_counts
        ),
        coverage_args=lambda wildcards, input: " ".join(
            f"--coverage {shlex.quote(path)}" for path in input.coverages
        ),
        summary_args=lambda wildcards, input: " ".join(
            f"--summary {shlex.quote(path)}" for path in input.summaries
        ),
        shared_min_total_reads=PREMRNA_CFG["shared_min_total_reads_all_samples"],
        benchmark_dir=str(Path(benchmark_path("premrna_aggregate", "combined.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "8G",
            "premrna_agg",
            log_path("slurm", "premrna_agg.%A.log"),
            config["resources"]["premrna_aggregate_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.metaprofile_by_sample})" "$(dirname {log})" "{params.benchmark_dir}"
        python {params.script} \
          {params.gene_count_args} \
          {params.coverage_args} \
          {params.summary_args} \
          --shared-min-total-reads {params.shared_min_total_reads} \
          --output-metaprofile-by-sample {output.metaprofile_by_sample} \
          --output-metaprofile-by-condition {output.metaprofile_by_condition} \
          --output-summary-by-sample {output.summary_by_sample} \
          --output-summary-by-condition {output.summary_by_condition} \
          --output-shared-genes {output.shared_genes} \
          > {log} 2>&1
        """


