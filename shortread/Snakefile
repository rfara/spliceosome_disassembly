        script=str((SCRIPTS_DIR / "export_plot_source_data.py").resolve()),
        combined_metaprofile_output=Path(PLOT_COMBINED_METAPROFILE_PANEL).name,
        three_prime_all_output=Path(PLOT_THREE_PRIME_METAPROFILE_ALL_INTRONS).name,
