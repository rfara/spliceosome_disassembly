        percentile_dis_ils=PLOT_SOURCE_DATA_PERCENTILE_DIS_ILS,
        ils_dis_pie=PLOT_SOURCE_DATA_ILS_DIS_PIE,
        manifest=PLOT_SOURCE_DATA_MANIFEST
    log:
        log_path("plots", "plot_source_data.log")
    benchmark:
