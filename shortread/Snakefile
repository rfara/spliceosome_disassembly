        anchor_window=BRANCHPOINT_CFG.get("anchor_window", 5),
        anchor_upstream=BRANCHPOINT_CFG.get("anchor_upstream", BRANCHPOINT_CFG.get("anchor_window", 5)),
        anchor_downstream=BRANCHPOINT_CFG.get("anchor_downstream", BRANCHPOINT_CFG.get("anchor_window", 5)),
        profile_upstream=BRANCHPOINT_CFG["profile_upstream"],
        profile_downstream=BRANCHPOINT_CFG["profile_downstream"],
        three_prime_coverage_upstream=BRANCHPOINT_CFG.get(
            "three_prime_coverage_upstream",
            BRANCHPOINT_CFG["profile_upstream"],
        ),
        three_prime_coverage_downstream=BRANCHPOINT_CFG.get(
            "three_prime_coverage_downstream",
            BRANCHPOINT_CFG["profile_downstream"],
        ),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("branchpoints_quantify", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "16G",
            "bp_quant",
            log_path("slurm", f"bp_quant.{wildcards.sample}.%A.log"),
            config["resources"]["branchpoint_quant_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.site_counts})" "$(dirname {log})" "{params.benchmark_dir}"
        python {params.script} \
          --bam {input.bam} \
          --reference {input.reference} \
          --sample {wildcards.sample} \
          --condition {params.condition} \
          --anchor-window {params.anchor_window} \
          --anchor-upstream {params.anchor_upstream} \
          --anchor-downstream {params.anchor_downstream} \
          --profile-upstream {params.profile_upstream} \
          --profile-downstream {params.profile_downstream} \
          --three-prime-coverage-upstream {params.three_prime_coverage_upstream} \
          --three-prime-coverage-downstream {params.three_prime_coverage_downstream} \
          --output-site-counts {output.site_counts} \
          --output-offset-counts {output.offset_counts} \
          --output-three-prime-coverage {output.three_prime_coverage} \
          --output-metaprofile {output.metaprofile} \
          --output-summary {output.summary} \
          > {log} 2>&1
        """


rule aggregate_branchpoint_profiles:
    input:
        init=INIT_SENTINEL,
        metaprofiles=expand(BRANCHPOINT_SAMPLE_METAPROFILE, sample=SAMPLES),
        summaries=expand(BRANCHPOINT_SAMPLE_SUMMARY, sample=SAMPLES),
        site_counts=expand(BRANCHPOINT_SAMPLE_SITE_COUNTS, sample=SAMPLES),
        intron_offsets=expand(BRANCHPOINT_SAMPLE_INTRON_OFFSETS, sample=SAMPLES),
        three_prime_coverages=expand(BRANCHPOINT_SAMPLE_THREE_PRIME_COVERAGE, sample=SAMPLES)
    output:
        metaprofile_by_sample=BRANCHPOINT_COMBINED_METAPROFILE_BY_SAMPLE,
        metaprofile_by_condition=BRANCHPOINT_COMBINED_METAPROFILE_BY_CONDITION,
        summary_by_sample=BRANCHPOINT_COMBINED_SUMMARY_BY_SAMPLE,
        summary_by_condition=BRANCHPOINT_COMBINED_SUMMARY_BY_CONDITION,
        analysis_introns=BRANCHPOINT_COMBINED_ANALYSIS_INTRONS,
        three_prime_coverage_by_sample=BRANCHPOINT_COMBINED_THREE_PRIME_COVERAGE_BY_SAMPLE,
        three_prime_coverage_by_condition=BRANCHPOINT_COMBINED_THREE_PRIME_COVERAGE_BY_CONDITION,
        three_prime_coverage_all_by_sample=BRANCHPOINT_COMBINED_THREE_PRIME_COVERAGE_ALL_BY_SAMPLE,
        three_prime_coverage_all_by_condition=BRANCHPOINT_COMBINED_THREE_PRIME_COVERAGE_ALL_BY_CONDITION
    log:
        log_path("branchpoints_aggregate", "combined.log")
    benchmark:
        benchmark_path("branchpoints_aggregate", "combined.tsv")
    threads: config["resources"]["branchpoint_aggregate_threads"]
    conda:
        str(ENV_YAML)
    params:
        script=str((SCRIPTS_DIR / "aggregate_branchpoint_profiles.py").resolve()),
        metaprofile_args=lambda wildcards, input: " ".join(
            f"--metaprofile {shlex.quote(path)}" for path in input.metaprofiles
        ),
        summary_args=lambda wildcards, input: " ".join(
            f"--summary {shlex.quote(path)}" for path in input.summaries
        ),
        site_count_args=lambda wildcards, input: " ".join(
            f"--site-counts {shlex.quote(path)}" for path in input.site_counts
        ),
        intron_offset_args=lambda wildcards, input: " ".join(
            f"--intron-offsets {shlex.quote(path)}" for path in input.intron_offsets
        ),
        three_prime_coverage_args=lambda wildcards, input: " ".join(
            f"--three-prime-coverage {shlex.quote(path)}" for path in input.three_prime_coverages
        ),
        analysis_min_reads=BRANCHPOINT_CFG["min_anchored_reads_all_samples_for_analysis_inclusion"],
        benchmark_dir=str(Path(benchmark_path("branchpoints_aggregate", "combined.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "8G",
            "bp_agg",
            log_path("slurm", "bp_agg.%A.log"),
            config["resources"]["branchpoint_aggregate_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.metaprofile_by_sample})" "$(dirname {log})" "{params.benchmark_dir}"
        python {params.script} \
          {params.metaprofile_args} \
          {params.summary_args} \
          {params.site_count_args} \
          {params.intron_offset_args} \
          {params.three_prime_coverage_args} \
          --analysis-min-reads {params.analysis_min_reads} \
          --output-metaprofile-by-sample {output.metaprofile_by_sample} \
          --output-metaprofile-by-condition {output.metaprofile_by_condition} \
          --output-summary-by-sample {output.summary_by_sample} \
          --output-summary-by-condition {output.summary_by_condition} \
          --output-analysis-introns {output.analysis_introns} \
          --output-three-prime-coverage-by-sample {output.three_prime_coverage_by_sample} \
          --output-three-prime-coverage-by-condition {output.three_prime_coverage_by_condition} \
          --output-three-prime-coverage-all-by-sample {output.three_prime_coverage_all_by_sample} \
          --output-three-prime-coverage-all-by-condition {output.three_prime_coverage_all_by_condition} \
          > {log} 2>&1
        """


