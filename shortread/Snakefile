rule initialize_workdirs:
    output:
        touch(INIT_SENTINEL)
    shell:
        r"""
        set -euo pipefail
        mkdir -p {WORKFLOW_DIRS:q}
        touch {output}
        """


rule download_geo_fastqs:
    input:
        init=INIT_SENTINEL,
        downloader=str((SCRIPTS_DIR / "download_reference.py").resolve())
    output:
        r1=RAW_R1_PATTERN,
        r2=RAW_R2_PATTERN
    log:
        log_path("download", "{sample}.log")
    benchmark:
        benchmark_path("download", "{sample}.tsv")
    threads: config["resources"]["download_threads"]
    conda:
        str(ENV_YAML)
    params:
        accession=lambda wildcards: config["samples"][wildcards.sample]["accession"],
        fallback_url=lambda wildcards: config["samples"][wildcards.sample]["fallback_url"],
        fallback_md5=lambda wildcards: config["samples"][wildcards.sample]["fallback_md5"],
        tmp_root=results_path("tmp", "sra"),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("download", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "24G",
            "geo_fastq",
            log_path("slurm", f"download.{wildcards.sample}.%A.log"),
            config["resources"]["download_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.r1:q})" "$(dirname {log:q})" "{params.benchmark_dir}" "{params.tmp_root}"
        exec > {log:q} 2>&1
        tmpdir="$(mktemp -d "{params.tmp_root}/{wildcards.sample}.XXXXXX")"
        trap 'rm -rf "$tmpdir"' EXIT
        mkdir -p "$tmpdir/sra" "$tmpdir/fastq" "$tmpdir/fasterq_tmp"

        run={params.accession:q}
        if ! prefetch --max-size u --output-directory "$tmpdir/sra" "$run"; then
          echo "Accession lookup failed; using the checksum-pinned NCBI fallback URL."
          rm -rf "$tmpdir/sra/$run"
          mkdir -p "$tmpdir/sra/$run"
          python {input.downloader:q} \
            --url {params.fallback_url:q} \
            --compressed-md5 {params.fallback_md5:q} \
            --output "$tmpdir/sra/$run/$run.sra"
        fi
        vdb-validate "$tmpdir/sra/$run"
        fasterq-dump \
          --split-files \
          --threads {threads} \
          --temp "$tmpdir/fasterq_tmp" \
          --outdir "$tmpdir/fastq" \
          "$tmpdir/sra/$run"

        downloaded_r1="$tmpdir/fastq/{params.accession}_1.fastq"
        downloaded_r2="$tmpdir/fastq/{params.accession}_2.fastq"
        test -s "$downloaded_r1"
        test -s "$downloaded_r2"
        pigz --processes {threads} "$downloaded_r1"
        pigz --processes {threads} "$downloaded_r2"
        gzip -t "$downloaded_r1.gz" "$downloaded_r2.gz"
        mv "$downloaded_r1.gz" {output.r1:q}
        mv "$downloaded_r2.gz" {output.r2:q}
        """


