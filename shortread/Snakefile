        percentile_ils_dis_output=Path(PLOT_PERCENTILE_ILS_DIS).name,
        percentile_dis_ils_output=Path(PLOT_PERCENTILE_DIS_ILS).name,
        ils_dis_pie_output=Path(PLOT_ILS_DIS_PIE).name,
        example_browser_outputs=";".join(
            [
                Path(PLOT_EXAMPLE_GENE_BROWSER_PDF).name,
                Path(PLOT_EXAMPLE_GENE_BROWSER_PNG).name,
                Path(PLOT_EXAMPLE_GENE_BROWSER_COVERAGE_ONLY).name,
                Path(PLOT_EXAMPLE_GENE_BROWSER_READS_ONLY).name,
            ]
        ),
        benchmark_dir=str(Path(benchmark_path("plots", "plot_source_data.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "4G",
            "plot_data",
