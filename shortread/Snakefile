          -p {output.r2} \
          {input.r1} \
          {input.r2} \
          > {log} 2>&1
        """


rule premap_rrna:
    input:
        init=INIT_SENTINEL,
        r1=results_path("umi", "ready", "r1", "{sample}.umi_ready.fastq.gz"),
        r2=results_path("umi", "ready", "r2", "{sample}.umi_ready.fastq.gz"),
        index=bowtie2_index_outputs(RRNA_INDEX_PREFIX)
    output:
        bam=results_path("premap_rrna", "{sample}.rrna.bam"),
        unmapped_r1=temp(results_path("premap_rrna", "{sample}.rrna_unmapped.1.fastq.gz")),
        unmapped_r2=temp(results_path("premap_rrna", "{sample}.rrna_unmapped.2.fastq.gz"))
    log:
        log_path("premap_rrna", "{sample}.log")
    benchmark:
        benchmark_path("premap_rrna", "{sample}.tsv")
    threads: config["resources"]["premap_threads"]
    conda:
        str(ENV_YAML)
    params:
        index_prefix=RRNA_INDEX_PREFIX,
        args=PREMAP_ARGS,
        temp_bam=lambda wildcards: results_path("tmp", "premap", f"{wildcards.sample}.rrna_premap.raw.bam"),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("premap_rrna", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "32G",
            "rrna_map",
            log_path("slurm", f"rrna_map.{wildcards.sample}.%A.log"),
            config["resources"]["premap_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "$(dirname {params.temp_bam})" "{params.benchmark_dir}"
        bowtie2 \
          --threads {threads} \
          -x {params.index_prefix} \
          -1 {input.r1} \
          -2 {input.r2} \
          --no-discordant \
          -k 1 \
          {params.args} \
          2> {log} \
        | samtools view -@ {threads} -u - > {params.temp_bam}
        samtools view -@ {threads} -u -F 12 {params.temp_bam} \
        | samtools sort -@ {threads} -o {output.bam} -
        samtools view -@ {threads} -u -f 12 {params.temp_bam} \
        | samtools collate -@ {threads} -u -O - \
        | samtools fastq \
            -1 >(gzip -c > {output.unmapped_r1}) \
            -2 >(gzip -c > {output.unmapped_r2}) \
            -0 /dev/null \
            -s /dev/null \
            -n -
        rm -f {params.temp_bam}
        """


rule premap_snrna:
    input:
        init=INIT_SENTINEL,
        r1=results_path("premap_rrna", "{sample}.rrna_unmapped.1.fastq.gz"),
        r2=results_path("premap_rrna", "{sample}.rrna_unmapped.2.fastq.gz"),
        index=bowtie2_index_outputs(SNRNA_INDEX_PREFIX)
    output:
        bam=results_path("premap_snrna", "{sample}.snrna.bam"),
        unmapped_r1=temp(results_path("premap_snrna", "{sample}.snrna_unmapped.1.fastq.gz")),
        unmapped_r2=temp(results_path("premap_snrna", "{sample}.snrna_unmapped.2.fastq.gz"))
    log:
        log_path("premap_snrna", "{sample}.log")
    benchmark:
        benchmark_path("premap_snrna", "{sample}.tsv")
    threads: config["resources"]["premap_threads"]
    conda:
        str(ENV_YAML)
    params:
        index_prefix=SNRNA_INDEX_PREFIX,
        args=PREMAP_ARGS,
        temp_bam=lambda wildcards: results_path("tmp", "premap", f"{wildcards.sample}.snrna_premap.raw.bam"),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("premap_snrna", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_medium",
            "32G",
            "snrna_map",
            log_path("slurm", f"snrna_map.{wildcards.sample}.%A.log"),
            config["resources"]["premap_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "$(dirname {params.temp_bam})" "{params.benchmark_dir}"
        bowtie2 \
          --threads {threads} \
          -x {params.index_prefix} \
          -1 {input.r1} \
          -2 {input.r2} \
          --no-discordant \
          -k 1 \
          {params.args} \
          2> {log} \
        | samtools view -@ {threads} -u - > {params.temp_bam}
        samtools view -@ {threads} -u -F 12 {params.temp_bam} \
        | samtools sort -@ {threads} -o {output.bam} -
        samtools view -@ {threads} -u -f 12 {params.temp_bam} \
        | samtools collate -@ {threads} -u -O - \
        | samtools fastq \
            -1 >(gzip -c > {output.unmapped_r1}) \
            -2 >(gzip -c > {output.unmapped_r2}) \
            -0 /dev/null \
            -s /dev/null \
            -n -
        rm -f {params.temp_bam}
        """


rule map_genome_star:
    input:
        init=INIT_SENTINEL,
        r1=results_path("premap_snrna", "{sample}.snrna_unmapped.1.fastq.gz"),
        r2=results_path("premap_snrna", "{sample}.snrna_unmapped.2.fastq.gz"),
        index=STAR_INDEX_DIR
    output:
        bam=results_path("star", "{sample}.Aligned.sortedByCoord.out.bam"),
        summary=results_path("star", "{sample}.Log.final.out"),
        junctions=results_path("star", "{sample}.SJ.out.tab"),
        unmapped_r1=results_path("star", "{sample}.Unmapped.out.mate1"),
        unmapped_r2=results_path("star", "{sample}.Unmapped.out.mate2")
    log:
        log_path("star", "{sample}.log")
    benchmark:
        benchmark_path("star", "{sample}.tsv")
    threads: config["resources"]["star_map_threads"]
    conda:
        str(ENV_YAML)
    params:
        prefix=lambda wildcards: results_path("star", f"{wildcards.sample}."),
        sort_ram=config["star"]["limit_bam_sort_ram"],
        align_extra=STAR_ALIGN_EXTRA,
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("star", f"{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "m_medium",
            "96G",
            "star_map",
            log_path("slurm", f"star_map.{wildcards.sample}.%A.log"),
            config["resources"]["star_map_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam})" "$(dirname {log})" "{params.benchmark_dir}"
        STAR \
          --runThreadN {threads} \
          --genomeDir {input.index} \
          --readFilesIn {input.r1} {input.r2} \
          --readFilesCommand zcat \
          --outReadsUnmapped Fastx \
          --outSAMtype BAM SortedByCoordinate \
          --outSAMattributes NH HI AS nM MD \
          --limitBAMsortRAM {params.sort_ram} \
          --outFileNamePrefix {params.prefix} \
          {params.align_extra} \
          > {log} 2>&1
        rm -f {params.prefix}Log.out {params.prefix}Log.progress.out
        """


rule fastqc_star_unmapped_reads:
    input:
        init=INIT_SENTINEL,
        r1=results_path("star", "{sample}.Unmapped.out.mate1"),
        r2=results_path("star", "{sample}.Unmapped.out.mate2")
    output:
        r1_html=results_path("qc", "fastqc", "star_unmapped", "r1", "{sample}.star_unmapped_fastqc.html"),
        r1_zip=results_path("qc", "fastqc", "star_unmapped", "r1", "{sample}.star_unmapped_fastqc.zip"),
        r2_html=results_path("qc", "fastqc", "star_unmapped", "r2", "{sample}.star_unmapped_fastqc.html"),
        r2_zip=results_path("qc", "fastqc", "star_unmapped", "r2", "{sample}.star_unmapped_fastqc.zip")
    log:
        log_path("qc_fastqc", "star_unmapped.{sample}.log")
    benchmark:
        benchmark_path("qc_fastqc", "star_unmapped.{sample}.tsv")
    threads: config["resources"]["fastqc_threads"]
    conda:
        str(ENV_YAML)
    params:
        outdir_r1=results_path("qc", "fastqc", "star_unmapped", "r1"),
        outdir_r2=results_path("qc", "fastqc", "star_unmapped", "r2"),
        # Keep the alias path literal so forced reruns do not resolve the existing
        # symlink back to the STAR input and try to relink a file onto itself.
        alias_r1=lambda wildcards: str(RESULTS_DIR.joinpath(
            "qc", "fastqc", "star_unmapped", "r1", f"{wildcards.sample}.star_unmapped.fastq"
        )),
        alias_r2=lambda wildcards: str(RESULTS_DIR.joinpath(
            "qc", "fastqc", "star_unmapped", "r2", f"{wildcards.sample}.star_unmapped.fastq"
        )),
        benchmark_dir=lambda wildcards: str(Path(benchmark_path("qc_fastqc", f"star_unmapped.{wildcards.sample}.tsv")).parent),
        cluster=lambda wildcards: slurm_cluster_args(
            "c_short",
            "8G",
            "fastqc_star_um",
            log_path("slurm", f"fastqc_star_unmapped.{wildcards.sample}.%A.log"),
            config["resources"]["fastqc_threads"],
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir_r1}" "{params.outdir_r2}" "$(dirname {log})" "{params.benchmark_dir}"
        ln -sf "{input.r1}" "{params.alias_r1}"
        ln -sf "{input.r2}" "{params.alias_r2}"
        fastqc --threads {threads} --outdir "{params.outdir_r1}" "{params.alias_r1}" > {log} 2>&1
        fastqc --threads {threads} --outdir "{params.outdir_r2}" "{params.alias_r2}" >> {log} 2>&1
        """


