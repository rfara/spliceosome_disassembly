        proportion_reads_stop_at_bp_output=Path(PLOT_PROPORTION_READS_STOP_AT_BP).name,
        downstream_exon_output=Path(PLOT_DOWNSTREAM_EXON_BRANCHPOINT_METAPROFILE).name,
        premrna_output=Path(PLOT_PROPORTION_EXONIC).name,
        percentile_ils_dis_output=Path(PLOT_PERCENTILE_ILS_DIS).name,
        percentile_dis_ils_output=Path(PLOT_PERCENTILE_DIS_ILS).name,
        ils_dis_pie_output=Path(PLOT_ILS_DIS_PIE).name,
        example_browser_outputs=";".join(
            [
                Path(PLOT_EXAMPLE_GENE_BROWSER_PDF).name,
                Path(PLOT_EXAMPLE_GENE_BROWSER_PNG).name,
                Path(PLOT_EXAMPLE_GENE_BROWSER_COVERAGE_ONLY).name,
                Path(PLOT_EXAMPLE_GENE_BROWSER_READS_ONLY).name,
            ]
        ),
        benchmark_dir=str(Path(benchmark_path("plots", "plot_analysis_counts.tsv")).parent),
        cluster=slurm_cluster_args(
            "c_short",
            "4G",
            "plot_counts",
            log_path("slurm", "plot_counts.%A.log"),
            1,
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.summary})" "$(dirname {log})" "{params.benchmark_dir}"
        python {params.script} \
          --branchpoint-summary {input.branchpoint_summary} \
          --branchpoint-three-prime {input.branchpoint_three_prime} \
          --downstream-summary {input.downstream_summary} \
          --premrna-summary {input.premrna_summary} \
          --percentile-ils-dis {input.percentile_ils_dis} \
          --percentile-dis-ils {input.percentile_dis_ils} \
          --example-browser-stats {input.example_browser_stats} \
          --combined-metaprofile-output {params.combined_metaprofile_output:q} \
          --three-prime-all-output {params.three_prime_all_output:q} \
          --proportion-reads-stop-at-bp-output {params.proportion_reads_stop_at_bp_output:q} \
          --downstream-exon-output {params.downstream_exon_output:q} \
          --premrna-output {params.premrna_output:q} \
          --percentile-ils-dis-output {params.percentile_ils_dis_output:q} \
          --percentile-dis-ils-output {params.percentile_dis_ils_output:q} \
          --ils-dis-pie-output {params.ils_dis_pie_output:q} \
          --example-browser-outputs {params.example_browser_outputs:q} \
          --output {output.summary} \
          > {log} 2>&1
        """


